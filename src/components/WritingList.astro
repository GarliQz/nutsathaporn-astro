---
import type { WritingLink } from '../lib/books';

interface Props {
  posts: WritingLink[];
}

const { posts } = Astro.props;
---

<section class="writing-section" aria-labelledby="writing-heading">
  <h1 id="writing-heading" class="section-title">
    <svg aria-hidden="true" viewBox="0 0 16 16">
      <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293z" />
    </svg>
    Blog I write
  </h1>
  <div class="writing-list">
    {posts.map((post) => (
      <a class="writing-card" href={post.link} target="_blank" rel="noopener noreferrer">
        <span>{post.title}</span>
        <span class="external-mark" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
